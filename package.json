{
  "name": "aryan-mudgal-portfolio",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/clean-dist.mjs && astro build",
    "preview": "astro preview",
    "rooms": "node scripts/crop-rooms.mjs",
    "test": "node --test tests/portfolio-source.test.mjs tests/github-pages-workflow.test.mjs tests/paper.test.mjs",
    "test:build": "node --test tests/portfolio-build.test.mjs",
    "check": "npm run test && npm run build && npm run test:build",
    "paper": "node scripts/paper.mjs",
    "crumple": "node scripts/crumple/render.mjs && node scripts/crumple/pack.mjs && node scripts/crumple/css.mjs"
  },
  "devDependencies": {
    "astro": "^7.1.3",
    "perfect-freehand": "1.2.2",
    "playwright": "1.64.1",
    "sharp": "^0.34.5",
    "simplex-noise": "4.0.3",
    "three": "0.169.0"
  }
}
