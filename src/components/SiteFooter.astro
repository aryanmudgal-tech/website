---
import { links } from "../data/portfolio";
---

<footer id="contact" class="site-footer story-close" aria-labelledby="contact-title">
  <div class="site-footer__inner shell">
    <div class="site-footer__prompt">
      <h2 id="contact-title">Let’s build what matters next.</h2>
      <a class="contact-link" href={links.email}>Email Aryan<span aria-hidden="true">↗</span></a>
    </div>
    <div class="site-footer__meta">
      <nav aria-label="External profiles">
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> opens in a new tab</span></a>
        <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> opens in a new tab</span></a>
      </nav>
      <p>© 2026 Aryan Mudgal</p>
    </div>
  </div>
</footer>
