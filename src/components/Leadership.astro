---
import { leadership, headings } from "../data/portfolio";
import { numeralRuns } from "../lib/text";
import Source from "./Source.astro";
import Print from "./Print.astro";
import Plate from "./Plate.astro";

/** Row ids: the title lowercased, each run of other characters a hyphen (spec 3). */
const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
---

<section id="leadership" class="section" aria-labelledby="leadership-title">
  <Plate name="leadership" />
  <h2 id="leadership-title">{headings.leadership}</h2>
  {leadership.map((item) => (
    <article class:list={["card", "card--leadership", item.roomId && "card--print"]} id={`leadership-${slug(item.title)}`}>
      <div class="card__meta">
        <h3 class="meta-lead">{item.title}</h3>
        <span class="meta__role">{item.role}</span>
        <span>{item.period}</span>
      </div>
      <div class="card__body">
        <p>{numeralRuns(item.summary).map((run) => (run.num ? <span class="num">{run.text}</span> : run.text))}</p>
        {item.receipts.length > 0 && (
          <div class="stubs">
            {item.receipts.map((receipt) => <Source receipt={receipt} variant="stub" />)}
          </div>
        )}
      </div>
      {item.roomId && (
        <div class="card__margin">
          <Print room={item.roomId} variant="margin" />
        </div>
      )}
    </article>
  ))}
</section>
