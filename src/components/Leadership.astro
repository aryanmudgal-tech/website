---
import { leadershipItems } from "../data/portfolio";
---

<section id="leadership" class="section section--leadership" aria-labelledby="leadership-title">
  <div class="shell">
    <header class="section-heading section-heading--compact reveal">
      <h2 id="leadership-title">Leadership with a real constituency</h2>
      <p>Representation, budgets, public-health work, and civic infrastructure at campus and community scale.</p>
    </header>

    <div class="leadership-mosaic">
      {leadershipItems.map((item) => (
        <article class:list={["leadership-item", `leadership-item--${item.scale}`, "reveal"]}>
          <p class="leadership-item__value">{item.value}</p>
          <h3>{item.title}</h3>
          <p>{item.context}</p>
        </article>
      ))}
    </div>
  </div>
</section>
