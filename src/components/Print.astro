---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { extras, rooms, type ChapterId } from "../data/rooms";
import PhotoPopover from "./PhotoPopover.astro";
import Source from "./Source.astro";

type Tape = { w: number; h: number; x: number; y: number; rotate: number };

interface Props {
  room?: ChapterId;
  extra?: string;
  variant: "hero" | "margin" | "footer";
  tilt?: number;
  tapes?: readonly Tape[];
  tone?: "plain" | "vermilion";
  loading?: "eager" | "lazy";
  popover?: boolean;
}

const { room, extra, variant, tapes, tone = "plain", loading = "lazy", popover = true } = Astro.props;
if (!room === !extra) throw new Error("Print takes exactly one of room and extra");

// Spec 7.2: default tilts, applied to the frame so captions stay level.
const TILTS: Record<string, number> = {
  pillar: 1.2, dots: -1.2, hero: 1.4, armie: 1, streamfair: -1, wod: 1.2, safeline: -1, research: -1,
  cleancampus: 1, chancellor: -1, pbk: 1.2, "pillar-pair": 1, contact: -1.6,
};
const DEFAULT_TAPES: Record<Props["variant"], readonly Tape[]> = {
  hero: [{ w: 88, h: 26, x: 84, y: -13, rotate: -3 }],
  margin: [{ w: 80, h: 22, x: -40, y: -11, rotate: -2 }],
  footer: [{ w: 78, h: 22, x: -18, y: -6, rotate: -32 }, { w: 70, h: 22, x: 216, y: -6, rotate: 28 }],
};
const SIZES: Record<Props["variant"], { widths: number[]; sizes: string }> = {
  hero: { widths: [336, 480, 634], sizes: "(max-width: 47.99rem) 204px, 336px" },
  margin: { widths: [284, 568, 716], sizes: "(max-width: 47.99rem) calc(100vw - 32px), 284px" },
  footer: { widths: [240, 480, 720], sizes: "240px" },
};

const roomImages = import.meta.glob<{ default: ImageMetadata }>("../assets/rooms/*.jpg", { eager: true });
const fullImages = import.meta.glob<{ default: ImageMetadata }>("../assets/full/*.jpg", { eager: true });
const record = room ? rooms.find((candidate) => candidate.id === room) : extras.find((candidate) => candidate.id === extra);
if (!record) throw new Error(`unknown print ${room ?? extra}`);
const image = (room ? roomImages[`../assets/rooms/${room}.jpg`] : fullImages[`../assets/full/${extra}.jpg`])?.default;
if (!image) throw new Error(`missing image for ${room ?? extra}; run npm run rooms`);
const { widths: wanted, sizes } = SIZES[variant];
const widths = [...new Set(wanted.filter((width) => width < image.width).concat(Math.min(image.width, Math.max(...wanted))))];
const tilt = Astro.props.tilt ?? TILTS[room ?? extra ?? ""] ?? 0;
const tapeList = tapes ?? DEFAULT_TAPES[variant];
const id = room ?? extra;
---

<figure class={`print print--${variant}`} data-room={room} data-extra={extra} style={`--tilt: ${tilt}deg`}>
  <div class="print__frame">
    {room ? (
      <button class="print__open" type="button" popovertarget={`photo-${room}`}>
        <Picture src={image} widths={widths} sizes={sizes} formats={["avif", "webp"]} alt={record.alt} loading={loading} fetchpriority={loading === "eager" ? "high" : undefined} decoding="async" />
        <span class="sr-only">Open full photo</span>
      </button>
    ) : (
      <Picture src={image} widths={widths} sizes={sizes} formats={["avif", "webp"]} alt={record.alt} loading={loading} decoding="async" />
    )}
    {tapeList.map((tape) => (
      <span class:list={["tape", tone === "vermilion" && "tape--vermilion"]} aria-hidden="true" style={`width: ${tape.w}px; height: ${tape.h}px; left: ${tape.x < 0 ? `calc(50% + ${tape.x}px)` : `${tape.x}px`}; top: ${tape.y}px; rotate: ${tape.rotate}deg`}></span>
    ))}
  </div>
  <figcaption class="print__caption">{record.caption}{room && "receipt" in record && <> <Source receipt={record.receipt} /></>}</figcaption>
</figure>
{room && popover && id && <PhotoPopover room={room} />}
