---
import { trajectoryEvents } from "../data/portfolio";
---

<section id="trajectory" class="nested-chapter nested-chapter--trajectory" aria-labelledby="trajectory-title">
  <header class="trajectory-heading reveal">
    <h2 id="trajectory-title">Career path</h2>
    <p>See how industry work, rapid builds, medical research, and public leadership began to reinforce each other.</p>
  </header>

  <ol class="trajectory-chronology" role="list">
    {trajectoryEvents.map((event) => (
      <li id={`trajectory-${event.id}`} class="trajectory-node reveal">
        <div class="trajectory-node__meta">
          <span>{event.period}</span>
          <span>{event.lane}</span>
        </div>
        <h3>{event.title}</h3>
        <p class="trajectory-node__outcome">{event.outcome}</p>
        <p class="trajectory-node__detail">{event.detail}</p>
      </li>
    ))}
  </ol>
</section>
