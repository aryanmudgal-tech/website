---
import { projects } from "../data/portfolio";
import { publicAssetUrl } from "../lib/site-url";

const leadProject = projects.find((project) => project.lead) ?? projects[0];
const supportingProjects = projects.filter((project) => project !== leadProject);
---

<section
  id="projects"
  class="section section--projects story-chapter story-chapter--projects"
  data-brain-scene="projects"
  aria-labelledby="projects-title"
>
  <div class="shell">
    <header class="section-heading section-heading--compact reveal">
      <h2 id="projects-title">Built under pressure.</h2>
      <p>Four team projects where the result was public, inspectable, and tested under real time pressure.</p>
    </header>

    <article class="project-lead reveal">
      <figure class="project-lead__media">
        <img
          src={publicAssetUrl(leadProject.image)}
          width={leadProject.imageWidth}
          height={leadProject.imageHeight}
          alt={leadProject.imageAlt}
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="project-lead__body">
        <div class="project-title-group">
          <p class="meta">{leadProject.event}</p>
          <h3>{leadProject.name}</h3>
          <p class="project-recognition">{leadProject.recognition}</p>
        </div>
        <dl class="project-facts">
          <div>
            <dt>Problem</dt>
            <dd>{leadProject.problem}</dd>
          </div>
          <div>
            <dt>Built</dt>
            <dd>{leadProject.built}</dd>
          </div>
          <div>
            <dt>{leadProject.scopeLabel}</dt>
            <dd>{leadProject.contribution}</dd>
          </div>
        </dl>
        <a class="text-link" href={leadProject.href} target="_blank" rel="noopener noreferrer">
          {leadProject.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only"> opens in a new tab</span>
        </a>
      </div>
    </article>

    <div class="project-matrix">
      {supportingProjects.map((project, index) => (
        <article class:list={["project-tile", `project-tile--${index + 1}`, "reveal"]}>
          <figure>
            <img
              src={publicAssetUrl(project.image)}
              width={project.imageWidth}
              height={project.imageHeight}
              alt={project.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="project-tile__body">
            <p class="meta">{project.event}</p>
            <h3>{project.name}</h3>
            <p class="project-recognition">{project.recognition}</p>
            <dl class="project-facts">
              <div>
                <dt>Problem</dt>
                <dd>{project.problem}</dd>
              </div>
              <div>
                <dt>Built</dt>
                <dd>{project.built}</dd>
              </div>
              <div>
                <dt>{project.scopeLabel}</dt>
                <dd>{project.contribution}</dd>
              </div>
            </dl>
            <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">
              {project.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only"> opens in a new tab</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
