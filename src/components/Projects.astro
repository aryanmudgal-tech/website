---
import { projects, headings } from "../data/portfolio";
import Source from "./Source.astro";
import Print from "./Print.astro";
import Video from "./Video.astro";
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <h2 id="projects-title">{headings.projects}</h2>
  <p class="lede">Hackathon builds, each finished in a day or two and shown to judges. Team size and my part are stated on every card.</p>
  <ol class="index" role="list">
    {projects.map((project) => (
      <li>
        <a class="index__name" href={`#project-${project.id}`}>{project.name}</a>
        <span class="index__result">{project.result}</span>
      </li>
    ))}
  </ol>
  {projects.map((project) => (
    <article class="card" id={`project-${project.id}`}>
      <div class="card__meta">
        <span>{project.event}</span>
        <span>{project.date}</span>
        {project.pool && <span>{project.pool}</span>}
        <span>Team: {project.team.join(", ")}.</span>
      </div>
      <div class="card__body">
        <h3>{project.name}</h3>
        <p class="result"><span class="hl--marigold">{project.result}</span></p>
        <p>{project.built}</p>
        {project.demo && <Video video={project.demo} mat="demo" />}
        <p class="my-part"><strong>My part.</strong> {project.myPart}</p>
        {project.aside && <p class="aside">{project.aside}</p>}
        <div class="stubs">
          {project.receipts.map((receipt) => <Source receipt={receipt} variant="stub" />)}
        </div>
      </div>
      <div class="card__margin">
        <Print room={project.id} variant="margin" tone="vermilion" />
        {project.id === "dots" && <Print room="hero" variant="margin" tone="vermilion" />}
      </div>
    </article>
  ))}
</section>
