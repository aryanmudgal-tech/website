---
import { navItems } from "../data/portfolio";
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="wordmark" href="#top">Aryan Mudgal</a>
    <nav class="site-nav site-nav--inline" aria-label="Primary">
      <ul role="list">
        {navItems.map((item) => (
          <li><a href={item.href} data-label={item.label}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <button class="menu-button" type="button" popovertarget="site-menu">Menu</button>
    <nav id="site-menu" class="site-nav site-nav--menu" popover aria-label="Menu">
      <ul role="list">
        {navItems.map((item) => (
          <li><a href={item.href} data-label={item.label}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]'));

  function setCurrent(id: string | null) {
    links.forEach((link) => {
      if (id && link.hash === `#${id}`) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  // Sheets move while they crumple, so the runways between them decide, since they never move: the current section
  // is the sheet after the last runway whose top has passed a line 20% down the screen (spec 8.4). Without motion the
  // runways are 0 tall and sit on the same boundaries, so the rule holds either way.
  const runways = Array.from(document.querySelectorAll<HTMLElement>(".runway"));
  const after = new Map(runways.map((runway) => [runway, document.querySelector(`[data-in="${runway.id}"] .content > [id]`)?.id ?? null]));
  const passed = new Map<Element, boolean>();
  const lastPassed = () => {
    const last = runways.filter((runway) => passed.get(runway)).pop();
    return last ? after.get(last) ?? null : null;
  };
  if (runways.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => passed.set(entry.target, entry.isIntersecting));
        setCurrent(lastPassed());
      },
      // Everything above the line counts as passed, so a jump of any size still crosses the line and fires.
      { rootMargin: "100000px 0px -80% 0px", threshold: 0 },
    );
    runways.forEach((runway) => observer.observe(runway));
  }

  // At the very end of the page Contact is current, whatever the runways say (spec 7.10).
  const pageEnd = document.getElementById("page-end");
  if (pageEnd) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) setCurrent("contact");
      else setCurrent(lastPassed());
    }, { threshold: 0 }).observe(pageEnd);
  }

  // Keyboard focus can land in a sheet still waiting under the one being read, or stop the scroll mid-crumple, because
  // the browser measures the moved box. Where the crumple runs, show the focused element where it lies at rest instead.
  if (CSS.supports("animation-timeline: view()") && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const laidOut = (element: HTMLElement) => {
      let y = 0;
      for (let node: HTMLElement | null = element; node; node = node.offsetParent as HTMLElement | null) y += node.offsetTop;
      return y;
    };
    const header = document.querySelector<HTMLElement>(".site-header");
    document.addEventListener("focusin", (event) => {
      const target = event.target as HTMLElement;
      const sheet = target.closest<HTMLElement>(".sheet");
      if (!sheet || target.closest("[popover]")) return;
      requestAnimationFrame(() => {
        const top = laidOut(target), pad = 24, head = header?.offsetHeight ?? 0;
        const arrived = sheet.dataset.in ? laidOut(document.getElementById(sheet.dataset.in)!) : 0;
        const leaves = sheet.dataset.out ? laidOut(document.getElementById(sheet.dataset.out)!) - innerHeight : document.documentElement.scrollHeight - innerHeight;
        let want = scrollY;
        if (top - head - pad < want) want = top - head - pad;
        else if (top + target.offsetHeight + pad > want + innerHeight) want = top + target.offsetHeight + pad - innerHeight;
        want = Math.min(Math.max(want, arrived), Math.max(arrived, leaves));
        if (Math.abs(want - scrollY) > 1) scrollTo({ top: want, behavior: "instant" });
      });
    });
  }

  const menu = document.getElementById("site-menu");
  if (menu && "hidePopover" in menu) {
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        try {
          (menu as HTMLElement & { hidePopover: () => void }).hidePopover();
        } catch {
          // already closed
        }
      });
    });
  }
</script>
