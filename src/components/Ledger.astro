---
import { ledger } from "../data/portfolio";
import Source from "./Source.astro";
---

<ol class="ledger" role="list" aria-label="Three proofs">
  {ledger.map((row) => (
    <li>
      <a class:list={["fig", row.bold && "fig--tape"]} href={row.anchor}>{row.fraction}</a>
      <p class="claim">{row.bold ? <strong>{row.text}</strong> : row.text} <Source receipt={row.receipt} /></p>
    </li>
  ))}
</ol>
