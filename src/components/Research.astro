---
import { research, headings } from "../data/portfolio";
import { researchParagraphs } from "../lib/text";
import Source from "./Source.astro";
import Print from "./Print.astro";
import Plate from "./Plate.astro";
---

<section id="research" class="section" aria-labelledby="research-title">
  <Plate name="research" />
  <h2 id="research-title">{headings.research}</h2>
  {research.map((item) => (
    <article class="card card--research">
      <div class="card__meta">
        <span class="meta-lead">{item.role}</span>
        <span>{item.period}</span>
      </div>
      <div class="card__body">
        <h3>{item.title}</h3>
        <p class="card__lede">{item.summary}</p>
        {researchParagraphs(item.detail).map((paragraph) => <p>{paragraph}</p>)}
        <div class="stubs">
          {item.receipts.map((receipt) => <Source receipt={receipt} variant="stub" />)}
        </div>
      </div>
      <div class="card__margin">
        <Print room="research" variant="margin" />
      </div>
    </article>
  ))}
</section>
