---
import { identity, links } from "../data/portfolio";
import { publicAssetUrl } from "../lib/site-url";
import Collage from "./Collage.astro";
import Ledger from "./Ledger.astro";
import PhotoPopover from "./PhotoPopover.astro";
import TitleBlock from "./TitleBlock.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__facts">
    <h1 id="hero-title">{identity.name}</h1>
    <TitleBlock />
    <Ledger />
    <div class="hero__actions">
      <a class="action action--primary" href={links.email}>Email Aryan</a>
      <a class="stub stub--resume" href={publicAssetUrl(links.resume)}>Resume (PDF)</a>
    </div>
  </div>
  <Collage />
  <PhotoPopover room="pillar" />
</section>
