---
import { recognitions, headings } from "../data/portfolio";
import Source from "./Source.astro";
import Print from "./Print.astro";
import Video from "./Video.astro";
---

<section id="recognition" class="section" aria-labelledby="recognition-title">
  <h2 id="recognition-title">{headings.recognition}</h2>
  {recognitions.map((award) => (
    <article class="card card--award" id={`recognition-${award.id}`}>
      <div class="card__meta">
        <span>{award.date}.</span>
      </div>
      <div class="card__body">
        <p class="award__line"><span class="award__fig">{award.fraction}</span> <span class="award__den">{award.denominator}</span>.</p>
        <h3>{award.title}</h3>
        <p>{award.context}</p>
        {award.video && <Video video={award.video} mat="plain" />}
        <div class="stubs">
          {award.receipts.map((receipt) => <Source receipt={receipt} variant="stub" />)}
        </div>
      </div>
      <div class="card__margin">
        {award.id === "pillar" ? <Print extra="pillar-pair" variant="margin" /> : <Print room={award.id} variant="margin" />}
      </div>
    </article>
  ))}
</section>
