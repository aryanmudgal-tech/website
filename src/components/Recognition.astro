---
import { recognitions } from "../data/portfolio";
---

<section id="recognition" class="section section--recognition" aria-labelledby="recognition-title">
  <div class="shell">
    <header class="recognition-heading reveal">
      <h2 id="recognition-title">Awards and honors</h2>
      <p>Three institutional signals spanning innovation, service, leadership, and academic achievement.</p>
    </header>

    <div class="recognition-strip">
      {recognitions.map((recognition, index) => (
        <article class:list={["recognition-item", `recognition-item--${index + 1}`, "reveal"]}>
          <figure>
            <img
              src={recognition.image}
              width={recognition.imageWidth}
              height={recognition.imageHeight}
              alt={recognition.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="recognition-item__copy">
            <p class="recognition-item__value">{recognition.value}</p>
            <h3>{recognition.title}</h3>
            <p>{recognition.context}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
