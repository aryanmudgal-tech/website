---
import { experiences, headings } from "../data/portfolio";
import Source from "./Source.astro";
import Plate from "./Plate.astro";
---

<section id="work" class="section" aria-labelledby="work-title">
  <Plate name="work" />
  <h2 id="work-title">{headings.work}</h2>
  {experiences.map((job) => (
    <article class="row">
      <div class="row__meta">
        <span class="meta-lead">{job.company}</span>
        <span class="meta__role">{job.role}</span>
        <span>{job.place}</span>
        <span>{job.period}</span>
      </div>
      <div class="row__body">
        <h3>{job.outcome}</h3>
        <p>{job.detail}</p>
        <p class="my-part"><strong>My part.</strong> {job.myPart}</p>
        <div class="stubs">
          {job.receipts.map((receipt) => <Source receipt={receipt} variant="stub" />)}
        </div>
      </div>
    </article>
  ))}
</section>
