---
import "../styles/global.css";
import { publicAssetUrl } from "../lib/site-url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Aryan Mudgal | Engineer and researcher",
  description = "Aryan Mudgal builds applied AI systems across industrial operations, human-AI interaction, and healthcare.",
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Aryan Mudgal",
  email: "mailto:aryanmudgal4493@gmail.com",
  jobTitle: "Software engineer and researcher",
  sameAs: [
    "https://www.linkedin.com/in/aryan-mudgal",
    "https://github.com/aryanmudgal-tech",
  ],
  knowsAbout: [
    "Applied artificial intelligence",
    "Machine learning",
    "Human-AI interaction",
    "Medical AI",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={publicAssetUrl("favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
